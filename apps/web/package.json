{
  "name": "@chat-to-video/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "preinstall": "node ../../scripts/enforce-pnpm.cjs",
    "build:workspace-deps": "pnpm --filter @chat-to-video/contracts build",
    "prebuild": "pnpm run build:workspace-deps",
    "build": "next build",
    "predev": "pnpm run build:workspace-deps",
    "dev": "node ../../scripts/run-web.cjs dev",
    "prestart": "pnpm run build",
    "start": "node ../../scripts/run-web.cjs start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "clean": "rimraf .next coverage"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.43",
    "@base-ui/react": "1.7.0",
    "@chat-to-video/contracts": "workspace:*",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/roboto-mono": "5.3.0",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "ai": "7.0.58",
    "alova": "3.5.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.30.0",
    "motion": "13.0.0",
    "nanoid": "6.0.1",
    "next": "16.2.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.12.2",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "use-stick-to-bottom": "1.1.6",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.26",
    "shadcn": "4.16.2",
    "tailwindcss": "4.3.3"
  }
}
