{
  "name": "chat-to-video",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=26.7.0 <27",
    "pnpm": ">=11.20.0 <12"
  },
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.cjs",
    "package-manager:check": "node scripts/enforce-pnpm.cjs",
    "deps:install:cn": "node scripts/install-with-registry-fallback.cjs",
    "sdk:docs:ai": "node scripts/search-sdk-docs.cjs ai",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:chat": "node scripts/run-chat-dev.cjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm run test:scripts && turbo run test",
    "test:scripts": "node --test scripts/*.test.cjs",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "globals": "17.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
