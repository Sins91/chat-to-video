{
  "name": "@chat-to-video/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "types": "./src/index.ts",
    "import": "./dist/index.js"
  },
  "types": "./src/index.ts",
  "scripts": {
    "preinstall": "node ../../scripts/enforce-pnpm.cjs",
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:history": "node scripts/seed-conversation-history.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@chat-to-video/contracts": "workspace:*",
    "drizzle-orm": "0.45.2",
    "mysql2": "3.23.2"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "drizzle-kit": "0.31.10"
  }
}
