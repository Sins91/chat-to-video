{
  "name": "@chat-to-video/workflow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "preinstall": "node ../../scripts/enforce-pnpm.cjs",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit && pnpm run typecheck:contracts",
    "typecheck:contracts": "tsc -p tsconfig.type-tests.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "workflow": "4.6.2"
  }
}
