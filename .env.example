NODE_ENV=development

WEB_PORT=4000
API_PORT=4101
# Local startup scripts derive API_BASE_URL from API_PORT.

MYSQL_PORT=4002
MYSQL_DATABASE=chat_to_video
MYSQL_USER=chat_to_video
MYSQL_PASSWORD=chat_to_video
MYSQL_ROOT_PASSWORD=change-me
DATABASE_URL=mysql://chat_to_video:chat_to_video@localhost:4002/chat_to_video
REDIS_PORT=4003
REDIS_URL=redis://localhost:4003
# Mastra workflow snapshots and Redis Streams require AOF or equivalent managed persistence.

S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=chat-to-video
S3_FORCE_PATH_STYLE=true

# Text LLM provider. APIMart is the default; set to deepseek only to use the retained direct entry.
LLM_PROVIDER=apimart
LLM_TOOL_CALLING_ENABLED=true
# Canary allowlist. Leave empty until a stage has met the required real-run acceptance gate.
CINEMATIC_SINGLE_PASS_STAGES=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=600000
DEEPSEEK_STORYBOARD_TIMEOUT_MS=120000

APIMART_BASE_URL=https://api.apimart.ai/v1
# Shared by chat, web search, transcription, TTS, image, video, and generated music providers.
APIMART_API_KEY=
APIMART_CHAT_MODEL=gpt-5-mini
APIMART_TIMEOUT_MS=600000
APIMART_STORYBOARD_TIMEOUT_MS=120000
# Worker fallback profile; new workflows use Seedance 2.0.
# MiniMax-Hailuo-2.3 remains readable only for historical workflow compatibility.
APIMART_VIDEO_MODEL=doubao-seedance-2.0
APIMART_VIDEO_DURATION_SECONDS=10
# Controls native audio generation for Seedance 2.0.
# Keep false until the opt-in Seedream 5 Pro / Seedance 2.0 reference-input integration contract passes.
APIMART_REFERENCE_INPUTS_VERIFIED=false
APIMART_VIDEO_POLL_INTERVAL_MS=5000
APIMART_VIDEO_RESULT_HOSTS=apimart.ai,getapib.org
APIMART_VIDEO_TASK_TIMEOUT_MS=900000
CINEMATIC_CREATION_ENABLED=true

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
